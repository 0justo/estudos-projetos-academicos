# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# ── Spotify ───────────────────────────────────────────────────────────────────
# Crie em: https://developer.spotify.com/dashboard
# Redirect URI local:  http://localhost:3000/auth/spotify/callback
# Redirect URI prod:   https://vitrolinha.app/auth/spotify/callback
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_client_secret_aqui

# ── Last.fm ───────────────────────────────────────────────────────────────────
# Crie em: https://www.last.fm/api/account/create
# ⚠️  Sem NEXT_PUBLIC_ — só usado no servidor
LASTFM_API_KEY=sua_lastfm_api_key_aqui

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Em produção: https://vitrolinha.app
